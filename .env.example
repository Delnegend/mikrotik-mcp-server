MIKROTIK_USER=admin
MIKROTIK_PASSWORD=
MIKROTIK_API_PASSWORDLESS_ENABLED=false
MIKROTIK_API_PASSWORDLESS_LENGTH=32
MIKROTIK_API_SSL=true
MIKROTIK_API_PORT=8729
MIKROTIK_TLS_VERIFY=true
MIKROTIK_API_TIMEOUT=10.0

# Fleet mode (optional): manage multiple routers. Inline JSON wins over file.
# Each device: {"title","host","port"(8728),"username"(admin),"password",
# "api_ssl"(true),"tls_verify"(true),"timeout"(10),"ssh_port"(22),
# "ssh_fingerprint","tags":[],"region"}
#MIKROTIK_INVENTORY=[{"title":"RouterA","host":"192.168.88.1","password":"pw"}]
#MIKROTIK_INVENTORY_FILE=C:\path\to\inventory.json

# Optional custom CA trust: drop PEM/CRT/CER CA certs into certs/.
# Files ending with .disabled are ignored.

# Optional SCP overrides for file download and backup tools.
MIKROTIK_SCP_HOST=
MIKROTIK_SCP_USER=
MIKROTIK_SCP_PASSWORD=
MIKROTIK_SCP_PRIVATE_KEY=
MIKROTIK_SCP_KEY_PASSPHRASE=
MIKROTIK_SCP_HOST_FINGERPRINT_SHA256=
# Set to 1 to skip SSH host key verification entirely (MITM risk, not recommended).
MIKROTIK_SCP_INSECURE=0
MIKROTIK_SCP_PORT=22
MIKROTIK_SCP_TIMEOUT=30.0
